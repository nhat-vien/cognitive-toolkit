# Equilibria / Mind Anchor — Modular Monolith Backend Configuration
APP_ENV=development
APP_NAME=Equilibria Cognitive Toolkit Backend API
APP_VERSION=1.0.0

# Database (SQLite local-first default; switch to PostgreSQL 16 + pgvector in production)
DATABASE_URL=sqlite:///./equilibria_clinical.db
POSTGRES_RLS_ENABLED=true

# Grounded Clinical RAG Configuration (inherited from KazKozDev/cbt-assistant)
RAG_SCORE_THRESHOLD=0.46
RAG_TOP_K=3
KNOWLEDGE_BASE_DIR=../../packages/clinical-protocols-kb/references
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Local Ollama Bridge (100% private local AI)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=8.0

# Security, JWT & Zero-Knowledge E2EE Sync
JWT_SECRET_KEY=replace-with-64-byte-cryptographically-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUDIT_HMAC_SECRET=equilibria-tamper-evident-audit-chain-key-2026

# Transactional Outbox Worker
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_MAX_RETRIES=3
