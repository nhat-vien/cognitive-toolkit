# Equilibria (Mind Anchor) — Vercel + Supabase Free Tier Environment Variables
# Copy this file to `apps/web-nextjs/.env.local` or set in Vercel Project Settings

# 1. Supabase Free Tier (PostgreSQL 16 + pgvector + RLS + Zero-Knowledge E2EE Sync)
# Leave blank to run in 100% self-contained Local/Edge Memory Mode
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-optional

# 2. Grounded Clinical RAG Contract (Strict Abstention below 0.46)
RAG_SCORE_THRESHOLD=0.46

# 3. Optional Local Ollama (Browser direct connection for 100% offline desktop AI)
NEXT_PUBLIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXT_PUBLIC_OLLAMA_MODEL=qwen2.5:7b
